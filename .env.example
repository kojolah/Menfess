APP_NAME="Ruang Kirim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campus_menfess
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+07:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Add the Web application OAuth client values from Google Cloud Console. Never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

QRIS_BASE_URL=https://qris.interactive.co.id/restapi/qris/
QRIS_MERCHANT_ID=
QRIS_API_KEY=
QRIS_USE_TIP=no
QRIS_TIMEOUT=15
QRIS_CHECK_COOLDOWN_SECONDS=10
QRIS_ENABLE_UNIQUE_AMOUNT=true
QRIS_MIN_UNIQUE_CODE=1
QRIS_MAX_UNIQUE_CODE=999
QRIS_MIN_TRANSACTION_AMOUNT_IDR=100
QRIS_MAX_TRANSACTION_AMOUNT_IDR=2000000

MENFESS_MAX_CHARACTERS=1000
GLOBAL_FREE_POSTS_PER_DAY=10
INSTAGRAM_FREE_POSTS_PER_DAY=2
INSTAGRAM_FREE_COOLDOWN_MINUTES=60
INSTAGRAM_PUBLICATION_TOKENS=2
X_PUBLICATION_TOKENS=1
PUBLISHER_MODE=simulation
MENFESS_BRAND_NAME="Ruang Kirim"
MENFESS_SOCIAL_USERNAME="@ruangkirim"
MENFESS_CANVAS_BACKGROUND="#F6DDE8"
MENFESS_CANVAS_BACKGROUNDS="#F6DDE8,#DCEBFA,#DDF2E5"
MENFESS_CANVAS_ACCENT="#DCEBFA"
# Keep playwright during migration validation; switch to imagick after the PHP extension and fonts are installed.
IMAGE_RENDERER=playwright
IMAGE_RENDERER_QUALITY=95
MENFESS_FONT_REGULAR=
MENFESS_FONT_BOLD=
MENFESS_FONT_SERIF=
NODE_BINARY=node

META_GRAPH_VERSION=v25.0
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN_EXPIRES_AT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OAuth 1.0a User Context for @unwarfess (Keys and tokens → API Key, API Key Secret,
# Access Token, Access Token Secret). Do not use OAuth 2.0 Client ID/Secret or the
# Bearer Token Application-Only; media upload and post creation reject app-only auth.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Aliases kept for compatibility if API Key values were previously stored here.
X_CLIENT_ID=
X_CLIENT_SECRET=
